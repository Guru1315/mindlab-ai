# ---------------------------------------------------------------------------
# MindLab AI environment variables
# Copy to .env.local for local development. Never commit real values.
# ---------------------------------------------------------------------------

# Supabase project (Project Settings -> API). The publishable/anon key is safe
# for the browser: every table is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Legacy projects can use the anon JWT instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Public URL of this app (used for OAuth and password-reset redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider. Any of these works; none is required.
#   auto (default) -> Gemini if GEMINI_API_KEY is set, else Vercel AI Gateway if
#                     AI_GATEWAY_API_KEY is set, else search mode (no AI).
#   gateway        -> Vercel AI Gateway. On Vercel no key is needed (the
#                     deployment's OIDC token is used); the team must have a
#                     credit card on file in Vercel to unlock gateway credits.
#   none           -> search mode: sources are indexed for keyword search and
#                     chat quotes matching passages; Studio/audio are disabled.
# ---------------------------------------------------------------------------
# AI_PROVIDER=auto

# Gemini API key from https://aistudio.google.com/apikey (server-side only).
GEMINI_API_KEY=

# Optional Vercel AI Gateway key (for local development or non-Vercel hosts).
# AI_GATEWAY_API_KEY=

# Optional model overrides (defaults verified against Gemini docs, Nov 2026).
# AI_CHAT_MODEL=gemini-3.8-flash
# AI_FAST_MODEL=gemini-3.5-flash-lite
# AI_EMBEDDING_MODEL=gemini-embedding-2
# AI_TTS_MODEL=gemini-3.8-flash-tts
# The database column is vector(768); keep this at 768 unless you migrate it.
# AI_EMBEDDING_DIMENSIONS=768

# Optional limits.
# MAX_UPLOAD_MB=25
# MAX_SOURCES_PER_NOTEBOOK=50
# RATE_LIMIT_CHAT_PER_HOUR=120
# RATE_LIMIT_GENERATION_PER_HOUR=30
# RATE_LIMIT_AUDIO_PER_DAY=10
# RATE_LIMIT_INGEST_PER_HOUR=60

# NOTE: The Supabase service-role key is NOT used by this app. All server work
# runs with the signed-in user's token so Row Level Security always applies.
